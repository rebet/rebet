{
    "name": "rebet",
    "dockerComposeFile": ["docker-compose.yml"],
    "service": "workspace",
    "forwardPorts": [ 9003 ],
    "workspaceFolder": "/workspace",
	"remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "settings": {
                "php.validate.enable": false,
                "php.suggest.basic": false,
                "php-cs-fixer.onsave": true,
                "php-cs-fixer.executablePath": "/workspace/vendor/bin/php-cs-fixer",
                "phpstan.binCommand": ["/workspace/vendor/bin/phpstan"],
                "phpstan.memoryLimit": "1G",
                "phpstan.timeout": 30000,
                "[php]": {
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "junstyle.php-cs-fixer"
                }
            },
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "donjayamanne.githistory",
                "EditorConfig.EditorConfig",
                "junstyle.php-cs-fixer",
                "mblode.twig-language-2",
                "mikestead.dotenv",
                "mhutchie.git-graph",
                "neilbrayfield.php-docblocker",
                "oderwat.indent-rainbow",
                "onecentlin.laravel-blade",
                "sanderronde.phpstan-vscode",
                "xdebug.php-debug",
                "usernamehw.errorlens"
            ]
        }
    },
    "postCreateCommand": "/bin/bash ./.devcontainer/post_create_command.sh"
}