APP_ENV=local
APP_DOMAIN={! $domain !}

DEFAULT_HASH_SALT=salt
DEFAULT_HASH_PEPPER=pepper
DEFAULT_HMAC_SECRET_KEY=hmac_secret
DEFAULT_CRYPTO_SECRET_KEY=crypto_secret

#{%-- commentif !$use_db, '# ', '--- Please uncomment if you want to use database ---' -%}
DB_USERNAME={! $db_user !}
DB_PASSWORD={! $db_pass !}
#{%-- endcommentif -%}

#{%-- if $use_cache && $cache == 'memcached' -%}
CACHE_MEMCACHED_DSN=memcached://memcached-cache:11211
# --- Please uncomment if you want to use SASL authentication for the memcached cache store (see config/cache.php) ---
# CACHE_MEMCACHED_USERNAME=
# CACHE_MEMCACHED_PASSWORD=

#{%-- endif -%}
#{%-- if $use_cache && $cache == 'redis' -%}
CACHE_REDIS_DSN=redis://redis-cache:6379/0

#{%-- endif -%}
#{%-- if $session == 'memcached' -%}
SESSION_MEMCACHED_DSN=memcached://memcached-session:11211
# --- Please uncomment if you want to use SASL authentication for the memcached session storage (see config/http.php) ---
# SESSION_MEMCACHED_USERNAME=
# SESSION_MEMCACHED_PASSWORD=

#{%-- endif -%}
#{%-- if $session == 'redis' -%}
SESSION_REDIS_DSN=redis://redis-session:6379/0

#{%-- endif -%}
#{%-- if $session == 'mongodb' -%}
SESSION_MONGODB_URI=mongodb://mongodb:27017

#{%-- endif -%}

MAILER_DSN=smtp://mailpit:1025
