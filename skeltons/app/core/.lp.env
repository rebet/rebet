APP_ENV=local
APP_DOMAIN={! $domain !}

DEFAULT_HASH_SALT=salt
DEFAULT_HASH_PEPPER=pepper
DEFAULT_HMAC_SECRET_KEY=hmac_secret
DEFAULT_CRYPTO_SECRET_KEY=crypto_secret

#{%-- commentif !$use_db, '# ', '--- Please uncomment if you want to use database ---' -%}
DB_USERNAME={! $db_user !}
DB_PASSWORD={! $db_pass !}
#{%-- endcommentif -%}

#{%-- if $use_cache && $cache == 'memcached' -%}
# --- Please uncomment if you want to use SASL authentication for the memcached cache store (see configs/cache.php) ---
# MEMCACHED_CACHE_USERNAME=
# MEMCACHED_CACHE_PASSWORD=

#{%-- endif -%}

MAILER_DSN=smtp://mailpit:1025
