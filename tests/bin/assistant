#!/usr/bin/env php
<?php

declare(strict_types=1);

//-------------------------------------------------
// Register The Auto Loader
//-------------------------------------------------
require __DIR__ . '/../../vendor/autoload.php';

//-------------------------------------------------
// Create kernel and initilizing application
//-------------------------------------------------
$kernel = Rebet\Application\App::init(new TestApp\Console\AppCliKernel(new TestApp\AppStructure(__DIR__ . '/..')));

//-------------------------------------------------
// Invoke command and handle action
//-------------------------------------------------
$kernel->handle();

//-------------------------------------------------
// Terminate the application
//-------------------------------------------------
$kernel->terminate();
